+                            fd,
+                            libc::F_ADD_SEALS,
+                            libc::F_SEAL_GROW | libc::F_SEAL_SHRINK,
+                        ) < 0
+                        {
+                            error!("Failed to seal memfd: {:?}", io::Error::last_os_error());
+                            libc::close(fd);
+                            return Err(io::Error::last_os_error());
+                        }
                         debug!("Created memfd with fd={}", fd);
                         File::from_raw_fd(fd)
                     };
