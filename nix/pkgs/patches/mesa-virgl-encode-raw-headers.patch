+/* Forward the client's packed parameter sets (SPS/PPS/VPS/SEI) and slice
+ * headers to virglrenderer. A native VA driver takes its SPS/PPS from these
+ * packed headers - radeonsi has no other source for them - so the backend has
+ * to submit them to its own VA driver for the coded buffer to come out as a
+ * decodable bitstream. */
+static void fill_enc_raw_headers(uint32_t *num_raw_headers,
+                                 struct virgl_enc_raw_header *raw_headers,
+                                 uint8_t *data,
+                                 const struct util_dynarray *headers)
+{
+    uint32_t offset = 0, count = 0;
+
+    util_dynarray_foreach(headers, struct pipe_enc_raw_header, header) {
+        if (count >= VIRGL_ENC_MAX_RAW_HEADERS ||
+            header->size > VIRGL_ENC_RAW_HEADER_DATA_SIZE - offset)
+            break;
+        raw_headers[count].type = header->type;
+        raw_headers[count].is_slice = header->is_slice;
+        raw_headers[count].offset = offset;
+        raw_headers[count].size = header->size;
+        if (header->size)
+            memcpy(data + offset, header->buffer, header->size);
+        offset += header->size;
+        count++;
+    }
+
+    *num_raw_headers = count;
+}
