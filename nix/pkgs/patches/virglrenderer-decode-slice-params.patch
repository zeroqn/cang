+/* Reads the RBSP bit stream of a NAL, dropping the emulation prevention bytes
+ * (a 0x03 that follows two zero bytes is not part of the syntax). */
+struct h264_bits {
+    const unsigned char *p;
+    unsigned nbytes;
+    unsigned byte;
+    unsigned bit;
+};
+
+static unsigned h264_bit(struct h264_bits *b)
+{
+    unsigned bit;
+
+    if (b->byte >= b->nbytes)
+        return 0;
+    if (b->byte > 1 && b->p[b->byte] == 0x03 &&
+        b->p[b->byte - 1] == 0x00 && b->p[b->byte - 2] == 0x00) {
+        b->byte++;
+        b->bit = 0;
+        if (b->byte >= b->nbytes)
+            return 0;
+    }
+
+    bit = (b->p[b->byte] >> (7 - b->bit)) & 1;
+    if (++b->bit == 8) {
+        b->bit = 0;
+        b->byte++;
+    }
+
+    return bit;
+}
+
+/* ue(v): leading zero bits, then that many bits of value. */
+static unsigned h264_ue(struct h264_bits *b)
+{
+    unsigned zeros = 0, val = 0, i;
+
+    while (!h264_bit(b)) {
+        if (++zeros > 31)
+            return 0;
+    }
+    for (i = 0; i < zeros; i++)
+        val = (val << 1) | h264_bit(b);
+
+    return (1u << zeros) - 1 + val;
+}
+
+/*
+ * The slice type the VA API asks for, read from the slice header of the first
+ * coded slice NAL in this submission. Two syntax elements - first_mb_in_slice
+ * and slice_type, both ue(v) - so a bit reader, not a parser.
+ *
+ * The host needs it and the protocol does not carry it: on the decode path
+ * mesa's fill_h264_picture_desc() sends no slice information at all (only
+ * slice_count and the reference list), and this slice parameter buffer is what
+ * the host's VA driver sees. radeonsi reads that field - it refuses a picture
+ * whose slice_type % 5 is not 2 (I) whenever it holds no reference frame of its
+ * own yet ("Need at least one reference for P/B frames" in si_video_dec.c) - so
+ * a P value, or whatever the stack held, turns the picture into a refused
+ * submission and the surface comes back cleared.
+ *
+ * Returns -1 when the submission holds no NAL this can read a slice header from.
+ */
+static int h264_first_slice_type(unsigned num_buffers,
+                                 const void * const *buffers,
+                                 const unsigned *sizes)
+{
+    unsigned i;
+
+    for (i = 0; i < num_buffers; i++) {
+        const unsigned char *p = buffers[i];
+        unsigned n = sizes[i], off;
+        struct h264_bits bits;
+        unsigned char nal_type;
+
+        /* start code 00 00 01, optionally preceded by a zero byte */
+        for (off = 0; off + 3 < n; off++) {
+            if (p[off] == 0 && p[off + 1] == 0 && p[off + 2] == 1)
+                break;
+        }
+        if (off + 3 >= n)
+            continue;
+
+        off += 3;
+        nal_type = p[off] & 0x1f;
+        if (nal_type != 1 && nal_type != 5)  /* non-IDR slice, IDR slice */
+            continue;
+
+        bits.p = p + off + 1;
+        bits.nbytes = n - off - 1;
+        bits.byte = 0;
+        bits.bit = 0;
+        (void)h264_ue(&bits);               /* first_mb_in_slice */
+        return (int)(h264_ue(&bits) % 5);    /* slice_type, 5-9 repeat 0-4 */
+    }
+
+    return -1;
+}
