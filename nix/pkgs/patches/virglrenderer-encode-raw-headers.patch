    uint8_t  enable_vui;
 
    uint32_t ltr_index;
+
+   uint32_t num_raw_headers;
+   struct virgl_enc_raw_header raw_headers[VIRGL_ENC_MAX_RAW_HEADERS];
+   uint8_t raw_header_data[VIRGL_ENC_RAW_HEADER_DATA_SIZE];
 };
 
 
@@ -531,6 +550,10 @@
    uint8_t  picture_type; /* see enum pipe_h2645_enc_picture_type */
