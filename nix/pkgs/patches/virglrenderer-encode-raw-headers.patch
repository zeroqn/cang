+/* Map a raw header's NAL unit type onto the packed header type the VA driver
+ * expects. Mesa's VA frontend re-derives the NAL type from the bytes, so this
+ * is only there to keep the buffers a native client would have submitted. */
+static VAEncPackedHeaderType enc_raw_header_va_type(uint32_t type, bool hevc)
+{
+   if (hevc) {
+      switch (type) {
+      case 32: /* VPS */
+      case 33: /* SPS */
+         return VAEncPackedHeaderSequence;
+      case 34: /* PPS */
+         return VAEncPackedHeaderPicture;
+      default:
+         return VAEncPackedHeaderRawData;
+      }
+   }
+
+   switch (type) {
+   case 7: /* SPS */
+      return VAEncPackedHeaderSequence;
+   case 8: /* PPS */
+      return VAEncPackedHeaderPicture;
+   case 1:  /* non-IDR slice */
+   case 5:  /* IDR slice */
+      return VAEncPackedHeaderSlice;
+   default:
+      return VAEncPackedHeaderRawData;
+   }
+}
+
+/* Forward the client's parameter sets (SPS/PPS/VPS/SEI) and slice headers to
+ * the VA driver as packed header buffers. The host driver writes the SPS/PPS
+ * itself from the parsed parameter sets (radeonsi has no other source for
+ * them), so without this the coded buffer holds slice data with no picture
+ * headers around it. */
+static int enc_render_raw_headers(struct virgl_video_codec *codec,
+                                  uint32_t num_raw_headers,
+                                  const struct virgl_enc_raw_header *raw_headers,
+                                  const uint8_t *data,
+                                  bool hevc)
+{
+   virgl_debug("encode raw headers: %u\n", num_raw_headers);
+
+   for (uint32_t i = 0; i < num_raw_headers; i++) {
+      const struct virgl_enc_raw_header *header = &raw_headers[i];
+      VAEncPackedHeaderParameterBuffer param;
+      VABufferID param_buf, data_buf;
+      VAStatus va_stat;
+
+      /* The guest is expected to be the matching build, but a stale tail in a
+       * short descriptor must not become a bogus packed header: only accept
+       * entries that are in range and start with a NAL start code. */
+      if (header->size < 4 ||
+          header->offset > VIRGL_ENC_RAW_HEADER_DATA_SIZE ||
+          header->size > VIRGL_ENC_RAW_HEADER_DATA_SIZE - header->offset)
+         continue;
+      if (!((data[header->offset] == 0x00 && data[header->offset + 1] == 0x00 &&
+             data[header->offset + 2] == 0x01) ||
+            (header->size >= 5 &&
+             data[header->offset + 1] == 0x00 && data[header->offset + 2] == 0x00 &&
+             data[header->offset + 3] == 0x01)))
+         continue;
+
+      memset(&param, 0, sizeof(param));
+      param.type = enc_raw_header_va_type(header->type, hevc);
+      param.bit_length = header->size * 8;
+      param.has_emulation_bytes = 1;
+
+      vaCreateBuffer(va_dpy, codec->va_ctx, VAEncPackedHeaderParameterBufferType,
+                     sizeof(param), 1, &param, &param_buf);
+      vaCreateBuffer(va_dpy, codec->va_ctx, VAEncPackedHeaderDataBufferType,
+                     header->size, 1, (void *)&data[header->offset], &data_buf);
+
+      va_stat = vaRenderPicture(va_dpy, codec->va_ctx, &param_buf, 1);
+      if (VA_STATUS_SUCCESS == va_stat)
+         va_stat = vaRenderPicture(va_dpy, codec->va_ctx, &data_buf, 1);
+      vaDestroyBuffer(va_dpy, param_buf);
+      vaDestroyBuffer(va_dpy, data_buf);
+
+      if (VA_STATUS_SUCCESS != va_stat) {
+         virgl_error("render encode raw header failed, err = 0x%x\n", va_stat);
+         return -1;
+      }
+   }
+
+   return 0;
+}
