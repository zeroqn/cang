+/* Raw (client-supplied) NAL/OBU headers for the encode path. The guest's VA
+ * client already hands its packed parameter sets (SPS/PPS/VPS/SEI) and slice
+ * headers to its own driver; virglrenderer forwards the bytes verbatim so the
+ * host driver can use them exactly as it would a native VA client's packed
+ * headers (which is the only source of SPS/PPS for drivers such as radeonsi). */
+#define VIRGL_ENC_MAX_RAW_HEADERS 8
+#define VIRGL_ENC_RAW_HEADER_DATA_SIZE 2048
+
+struct virgl_enc_raw_header {
+   uint32_t type;      /* nal_unit_type / obu_type */
+   uint32_t is_slice;  /* slice or frame header */
+   uint32_t offset;    /* offset into raw_header_data */
+   uint32_t size;      /* bytes at offset */
+};
+
