diff -ruN a/src/vrend/virgl_video.c b/src/vrend/virgl_video.c
--- a/src/vrend/virgl_video.c	2026-10-08 23:06:44.438959685 +0800
+++ b/src/vrend/virgl_video.c	2026-10-08 23:07:21.206972142 +0800
@@ -111,6 +111,7 @@
    VAConfigID  va_cfg;
    struct virgl_video_buffer *buffer;
    struct virgl_video_buffer *ref_pic_list[32]; /* Enc: reference pictures */
+   uint32_t ref_pic_poc[32];                   /* Enc: their picture-order counts */
    VABufferID  va_coded_buf;                    /* Enc: VACodedBuffer */
    void *opaque;                                /* User opaque data */
 };
@@ -1102,15 +1103,78 @@
 
     /* CurrPic */
     param->CurrPic.picture_id = get_enc_ref_pic(codec, desc->frame_num);
-    //CurrPic.frame_idx;
-    //CurrPic.flags;
+    param->CurrPic.frame_idx = desc->frame_num;
+    param->CurrPic.flags =
+        desc->not_referenced ? 0 : VA_PICTURE_H264_SHORT_TERM_REFERENCE;
     param->CurrPic.TopFieldOrderCnt = desc->pic_order_cnt;
-    //CurrPic.BottomFieldOrderCnt;
+    param->CurrPic.BottomFieldOrderCnt = desc->pic_order_cnt;
 
-    /* ReferenceFrames */
+    /* Remember this picture's order count under its frame number so a later
+     * picture that references it can name it in ReferenceFrames. Only
+     * reference pictures are recorded: a non-reference picture carries the
+     * frame number of the next reference and would overwrite its entry. */
+    if (!desc->not_referenced)
+        codec->ref_pic_poc[desc->frame_num % ARRAY_SIZE(codec->ref_pic_poc)] =
+            desc->pic_order_cnt;
+
+    /* ReferenceFrames: the DPB the slice's RefPicList0/1 entries resolve
+     * against. The VA driver evicts a DPB surface that no ReferenceFrames entry
+     * names, so without this every reference is dropped two frames after it was
+     * used - which is why enabling B-frames (whose lists reach further back)
+     * corrupted the stream. Fill it from the client's own lists, with the
+     * picture-order count vrend recorded for that surface. */
     for (i = 0; i < ARRAY_SIZE(param->ReferenceFrames); i++)
         h264_init_picture(&param->ReferenceFrames[i]);
 
+    {
+        unsigned n = 0, r;
+        const uint32_t l0 = desc->num_ref_idx_l0_active_minus1 + 1;
+        const uint32_t l1 = desc->num_ref_idx_l1_active_minus1 + 1;
+
+        for (r = 0; r < l0 && r < ARRAY_SIZE(desc->ref_idx_l0_list) &&
+                    n < ARRAY_SIZE(param->ReferenceFrames); r++) {
+            const uint32_t f = desc->ref_idx_l0_list[r];
+            VASurfaceID id;
+
+            if (f == VA_INVALID_ID)
+                continue;
+            id = get_enc_ref_pic(codec, f);
+            if (id == VA_INVALID_ID)
+                continue;
+            param->ReferenceFrames[n].picture_id = id;
+            param->ReferenceFrames[n].frame_idx = f;
+            param->ReferenceFrames[n].flags =
+                desc->l0_is_long_term[r]
+                    ? VA_PICTURE_H264_LONG_TERM_REFERENCE
+                    : VA_PICTURE_H264_SHORT_TERM_REFERENCE;
+            param->ReferenceFrames[n].TopFieldOrderCnt =
+                param->ReferenceFrames[n].BottomFieldOrderCnt =
+                    codec->ref_pic_poc[f % ARRAY_SIZE(codec->ref_pic_poc)];
+            n++;
+        }
+        for (r = 0; r < l1 && r < ARRAY_SIZE(desc->ref_idx_l1_list) &&
+                    n < ARRAY_SIZE(param->ReferenceFrames); r++) {
+            const uint32_t f = desc->ref_idx_l1_list[r];
+            VASurfaceID id;
+
+            if (f == VA_INVALID_ID)
+                continue;
+            id = get_enc_ref_pic(codec, f);
+            if (id == VA_INVALID_ID)
+                continue;
+            param->ReferenceFrames[n].picture_id = id;
+            param->ReferenceFrames[n].frame_idx = f;
+            param->ReferenceFrames[n].flags =
+                desc->l1_is_long_term[r]
+                    ? VA_PICTURE_H264_LONG_TERM_REFERENCE
+                    : VA_PICTURE_H264_SHORT_TERM_REFERENCE;
+            param->ReferenceFrames[n].TopFieldOrderCnt =
+                param->ReferenceFrames[n].BottomFieldOrderCnt =
+                    codec->ref_pic_poc[f % ARRAY_SIZE(codec->ref_pic_poc)];
+            n++;
+        }
+    }
+
     /* coded_buf */
     param->coded_buf = codec->va_coded_buf;
 
