+/* A decoded surface mapped into CPU memory.
+ *
+ * vrend used to copy the picture out of the DMA-BUF the surface exports, but that
+ * memory is the driver's to reuse: a surface's storage can be reallocated (and was
+ * - measured after an IDR, the guest then read a buffer whose contents never
+ * changed again), while the export is cached for as long as the video buffer
+ * lives. Reading the surface itself has no such window. */
+#define VIRGL_VIDEO_MAX_PLANES 4
+
+/* How a mapped surface's chroma is stored, so vrend can describe it without VA
+ * constants. `fourcc` carries the driver's own answer for diagnostics. */
+enum virgl_video_surface_layout {
+    VIRGL_VIDEO_LAYOUT_UNKNOWN = 0,
+    /* One plane per component, Cb then Cr. */
+    VIRGL_VIDEO_LAYOUT_PLANAR,
+    /* Luma plus one interleaved CbCr plane. */
+    VIRGL_VIDEO_LAYOUT_NV12,
+    /* Luma plus one interleaved CrCb plane. */
+    VIRGL_VIDEO_LAYOUT_NV21,
+};
+
+struct virgl_video_mapped_surface {
+    uint32_t fourcc;
+    unsigned layout;
+    bool sixteen_bit;
+    uint32_t num_planes;
+    const uint8_t *data[VIRGL_VIDEO_MAX_PLANES];
+    uint32_t pitch[VIRGL_VIDEO_MAX_PLANES];
+    uint32_t width[VIRGL_VIDEO_MAX_PLANES];
+    uint32_t height[VIRGL_VIDEO_MAX_PLANES];
+    /* Opaque: the VAImage and buffer the map holds until it is released. */
+    void *opaque;
+};
+
+/* Map/release the planes of the surface `buffer` describes. The caller must have
+ * synchronized it (see decode_completed). Returns 0 on success. */
+int virgl_video_map_surface(struct virgl_video_buffer *buffer,
+                            struct virgl_video_mapped_surface *mapped);
+void virgl_video_unmap_surface(struct virgl_video_mapped_surface *mapped);
