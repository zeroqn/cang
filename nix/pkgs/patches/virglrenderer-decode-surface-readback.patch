+struct virgl_video_mapped_surface_priv {
+    VAImage image;
+    void *va_ptr;
+};
+
+int virgl_video_map_surface(struct virgl_video_buffer *buffer,
+                            struct virgl_video_mapped_surface *mapped)
+{
+    struct virgl_video_mapped_surface_priv *priv;
+    VAStatus va_stat;
+    unsigned div;
+    unsigned i;
+
+    if (!va_dpy || !buffer || !mapped)
+        return -1;
+
+    memset(mapped, 0, sizeof(*mapped));
+
+    priv = calloc(1, sizeof(*priv));
+    if (!priv)
+        return -1;
+
+    /* Derive the surface's own layout: the driver knows what it allocated, and a
+     * surface that cannot be derived is copied out instead. */
+    va_stat = vaDeriveImage(va_dpy, buffer->va_sfc, &priv->image);
+    if (VA_STATUS_SUCCESS != va_stat) {
+        VAImageFormat format = {
+            .fourcc = VA_FOURCC_NV12,
+            .byte_order = VA_LSB_FIRST,
+        };
+
+        va_stat = vaCreateImage(va_dpy, &format, buffer->width, buffer->height,
+                                &priv->image);
+        if (VA_STATUS_SUCCESS != va_stat) {
+            virgl_error("derive and create image both failed, err = 0x%X\n", va_stat);
+            free(priv);
+            return -1;
+        }
+
+        va_stat = vaGetImage(va_dpy, buffer->va_sfc, 0, 0, buffer->width,
+                             buffer->height, priv->image.image_id);
+        if (VA_STATUS_SUCCESS != va_stat) {
+            virgl_error("get image failed, err = 0x%X\n", va_stat);
+            vaDestroyImage(va_dpy, priv->image.image_id);
+            free(priv);
+            return -1;
+        }
+    }
+
+    va_stat = vaMapBuffer(va_dpy, priv->image.buf, &priv->va_ptr);
+    if (VA_STATUS_SUCCESS != va_stat || !priv->va_ptr) {
+        virgl_error("map image buffer failed, err = 0x%X\n", va_stat);
+        vaDestroyImage(va_dpy, priv->image.image_id);
+        free(priv);
+        return -1;
+    }
+
+    div = fourcc_chroma_div(priv->image.format.fourcc);
+
+    switch (priv->image.format.fourcc) {
+    case VA_FOURCC_I420:
+    case VA_FOURCC_YV12:
+    case VA_FOURCC_IMC3:
+        mapped->layout = priv->image.num_planes >= 3 ? VIRGL_VIDEO_LAYOUT_PLANAR
+                                                     : VIRGL_VIDEO_LAYOUT_UNKNOWN;
+        break;
+    case VA_FOURCC_NV12:
+        mapped->layout = VIRGL_VIDEO_LAYOUT_NV12;
+        break;
+    case VA_FOURCC_NV21:
+        mapped->layout = VIRGL_VIDEO_LAYOUT_NV21;
+        break;
+    case VA_FOURCC_P010:
+    case VA_FOURCC_P012:
+    case VA_FOURCC_P016:
+        mapped->layout = VIRGL_VIDEO_LAYOUT_NV12;
+        mapped->sixteen_bit = true;
+        break;
+    default:
+        mapped->layout = VIRGL_VIDEO_LAYOUT_UNKNOWN;
+        break;
+    }
+
+    if (mapped->layout == VIRGL_VIDEO_LAYOUT_UNKNOWN) {
+        virgl_error("surface fourcc 0x%08x with %u planes is not a layout this "
+                    "path converts\n", priv->image.format.fourcc,
+                    priv->image.num_planes);
+        vaUnmapBuffer(va_dpy, priv->image.buf);
+        vaDestroyImage(va_dpy, priv->image.image_id);
+        free(priv);
+        return -1;
+    }
+
+    mapped->fourcc = priv->image.format.fourcc;
+    mapped->num_planes = priv->image.num_planes < VIRGL_VIDEO_MAX_PLANES
+                             ? priv->image.num_planes
+                             : VIRGL_VIDEO_MAX_PLANES;
+    for (i = 0; i < mapped->num_planes; i++) {
+        mapped->data[i] = (const uint8_t *)priv->va_ptr + priv->image.offsets[i];
+        mapped->pitch[i] = priv->image.pitches[i];
+        mapped->width[i] = i == 0 ? priv->image.width : priv->image.width / div;
+        mapped->height[i] = i == 0 ? priv->image.height : priv->image.height / div;
+    }
+    mapped->opaque = priv;
+
+    return 0;
+}
+
+void virgl_video_unmap_surface(struct virgl_video_mapped_surface *mapped)
+{
+    struct virgl_video_mapped_surface_priv *priv;
+
+    if (!mapped || !mapped->opaque)
+        return;
+
+    priv = mapped->opaque;
+
+    vaUnmapBuffer(va_dpy, priv->image.buf);
+    vaDestroyImage(va_dpy, priv->image.image_id);
+    free(priv);
+    mapped->opaque = NULL;
+}
