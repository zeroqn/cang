+/* The chroma divisor of a fourcc: 2 for the 4:2:0 formats vrend meets, 1 for a
+ * format whose chroma planes are full size. */
+static unsigned fourcc_chroma_div(uint32_t fourcc)
+{
+    switch (fourcc) {
+    case VA_FOURCC_NV12:
+    case VA_FOURCC_NV21:
+    case VA_FOURCC_I420:
+    case VA_FOURCC_YV12:
+    case VA_FOURCC_IMC3:
+    case VA_FOURCC_P010:
+    case VA_FOURCC_P012:
+    case VA_FOURCC_P016:
+        return 2;
+    default:
+        return 1;
+    }
+}
