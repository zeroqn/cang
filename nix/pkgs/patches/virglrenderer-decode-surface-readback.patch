+/* Pack one plane of the guest's video buffer out of the host surface's planes.
+ *
+ * The guest's layout comes from its plane count - a 4:2:0 picture with three
+ * planes is luma, Cb, Cr (what a VA_RT_FORMAT_YUV420 surface means to the guest's
+ * VA frontend, and the layout the guest's buffer uses bit-exactly), with two it is
+ * luma plus interleaved chroma - and the host's from the fourcc its surface was
+ * derived with. Neither description can be bent to match the other: the
+ * create-buffer message carries only the pipe format, the geometry and the
+ * resource list, and vaExportSurfaceHandle()'s descriptor is an output. A pair
+ * this cannot build is an error.
+ */
+static void *pack_plane(const struct virgl_video_mapped_surface *mapped,
+                        unsigned guest_planes, unsigned plane,
+                        unsigned *out_width, unsigned *out_height)
+{
+    bool sixteen_bit = mapped->sixteen_bit;
+    bool host_planar = mapped->layout == VIRGL_VIDEO_LAYOUT_PLANAR;
+    bool host_nv21 = mapped->layout == VIRGL_VIDEO_LAYOUT_NV21;
+    unsigned channel_bytes = sixteen_bit ? 2 : 1;
+    unsigned channels = (guest_planes == 3 || plane == 0) ? 1 : 2;
+    unsigned width, height, x, y, c;
+    const uint8_t *host_plane[2] = { NULL, NULL };
+    unsigned host_pitch[2] = { 0, 0 };
+    unsigned char *packed;
+
+    if (mapped->num_planes < 2)
+        return NULL;
+
+    width = plane == 0 ? mapped->width[0] : mapped->width[1];
+    height = plane == 0 ? mapped->height[0] : mapped->height[1];
+    if (!width || !height)
+        return NULL;
+
+    packed = malloc((size_t)width * height * channels * channel_bytes);
+    if (!packed)
+        return NULL;
+
+    if (plane == 0) {
+        host_plane[0] = mapped->data[0];
+        host_pitch[0] = mapped->pitch[0];
+        for (y = 0; y < height; y++)
+            memcpy(packed + (size_t)y * width * channel_bytes,
+                   host_plane[0] + (size_t)y * host_pitch[0],
+                   (size_t)width * channel_bytes);
+        *out_width = width;
+        *out_height = height;
+        return packed;
+    }
+
+    if (host_planar) {
+        host_plane[0] = mapped->data[1];
+        host_pitch[0] = mapped->pitch[1];
+        host_plane[1] = mapped->data[2];
+        host_pitch[1] = mapped->pitch[2];
+    } else {
+        host_plane[0] = mapped->data[1];
+        host_pitch[0] = mapped->pitch[1];
+    }
+
+    for (y = 0; y < height; y++) {
+        const uint8_t *row0 = host_plane[0] + (size_t)y * host_pitch[0];
+        const uint8_t *row1 = host_planar ? host_plane[1] + (size_t)y * host_pitch[1] : NULL;
+        unsigned char *dst = packed + (size_t)y * width * channels * channel_bytes;
+
+        for (x = 0; x < width; x++) {
+            for (c = 0; c < channels; c++) {
+                /* Which chroma sample this channel holds: 0 = Cb, 1 = Cr. A
+                 * three-plane guest buffer takes one per plane; an interleaved one
+                 * takes the pair, swapped when the host's surface is NV21. */
+                unsigned sample;
+                const uint8_t *src;
+
+                if (guest_planes == 3)
+                    sample = plane == 1 ? 0 : 1;
+                else
+                    sample = c;
+
+                if (host_nv21)
+                    sample = 1 - sample;
+
+                if (host_planar)
+                    src = (sample == 0 ? row0 : row1) + (size_t)x * channel_bytes;
+                else
+                    src = row0 + ((size_t)x * 2 + sample) * channel_bytes;
+
+                memcpy(dst + ((size_t)x * channels + c) * channel_bytes, src,
+                       channel_bytes);
+            }
+        }
+    }
+
+    *out_width = width;
+    *out_height = height;
+    return packed;
+}
