+/* Fill one of the guest's chroma planes from an interleaved 4:2:0 chroma plane.
+ *
+ * The host exported the decoded surface with interleaved chroma (NV12: one
+ * two-channel plane, Cb then Cr byte-wise) while the guest's video buffer
+ * describes separate Cb and Cr planes, and a plane-by-plane blit can only move a
+ * whole plane - glCopyTexSubImage2D into a single-channel resource takes the
+ * source framebuffer's first channel and nothing else. `channel` selects which of
+ * the interleaved plane's two samples this guest plane holds (0 = Cb, 1 = Cr).
+ *
+ * The pass reads the interleaved plane back and uploads the wanted sample as the
+ * red channel, so the implicit RGBA -> R conversion of the upload picks it. Both
+ * GL_RGBA read and write are used so the pass does not depend on the attachment's
+ * own channel count: at 4:2:0 this moves the chroma of one frame (a quarter of the
+ * picture), luma never leaves the GPU, and a shader can replace the pass if a
+ * profile ever asks for it.
+ */
+static int split_interleaved_chroma_plane(struct vrend_video_plane *src,
+                                          struct vrend_resource *dst,
+                                          unsigned channel)
+{
+    unsigned width = dst->base.width0;
+    unsigned height = dst->base.height0;
+    unsigned char *pixels, *row;
+    unsigned x, y;
+
+    if (!width || !height)
+        return -1;
+
+    pixels = malloc((size_t)width * height * 4);
+    if (!pixels)
+        return -1;
+
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, src->framebuffer);
+    glPixelStorei(GL_PACK_ALIGNMENT, 1);
+    glReadPixels(0, 0, width, height, GL_RGBA, GL_UNSIGNED_BYTE, pixels);
+
+    for (y = 0; y < height; y++) {
+        row = pixels + (size_t)y * width * 4;
+        for (x = 0; x < width; x++) {
+            row[x * 4] = row[x * 4 + channel];
+            row[x * 4 + 1] = 0;
+            row[x * 4 + 2] = 0;
+            row[x * 4 + 3] = 255;
+        }
+    }
+
+    glBindTexture(GL_TEXTURE_2D, dst->gl_id);
+    glPixelStorei(GL_UNPACK_ALIGNMENT, 1);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, width, height, GL_RGBA,
+                    GL_UNSIGNED_BYTE, pixels);
+
+    free(pixels);
+
+    return 0;
+}
