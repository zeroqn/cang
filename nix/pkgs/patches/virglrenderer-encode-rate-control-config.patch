+/* Map the client's pipe rate-control method (which crosses the wire in the
+ * picture description) onto the VA config attribute a host VA driver expects.
+ * A VA driver decides its encoder's rate-control behaviour from the config, so
+ * carrying this across is what lets a client's -b:v / -qp reach the driver at
+ * all. */
+static uint32_t va_rc_from_pipe_rc(uint32_t method)
+{
+    switch (method) {
+    case PIPE_H2645_ENC_RATE_CONTROL_METHOD_CONSTANT:
+    case PIPE_H2645_ENC_RATE_CONTROL_METHOD_CONSTANT_SKIP:
+        return VA_RC_CBR;
+    case PIPE_H2645_ENC_RATE_CONTROL_METHOD_VARIABLE:
+    case PIPE_H2645_ENC_RATE_CONTROL_METHOD_VARIABLE_SKIP:
+        return VA_RC_VBR;
+    case PIPE_H2645_ENC_RATE_CONTROL_METHOD_QUALITY_VARIABLE:
+        return VA_RC_QVBR;
+    case PIPE_H2645_ENC_RATE_CONTROL_METHOD_DISABLE:
+    default:
+        return VA_RC_CQP;
+    }
+}
+
+/* Create (or, if the client switched mode, recreate) the encoder's VA config
+ * and context.
+ *
+ * The rate-control mode is a VA *config* attribute, so it has to be known when
+ * vaCreateConfig() is called - but vrend creates the codec at
+ * VIRGL_CCMD_CREATE_VIDEO_CODEC and the mode only arrives later, with the first
+ * picture's rate_ctrl_method.  The config is therefore created lazily from the
+ * first picture instead of in virgl_video_create_codec(); a client that changes
+ * the mode mid-stream gets a fresh config and context.  The VA surfaces in
+ * ref_pic_list[] belong to the codec, not the context, so they survive a
+ * recreate. */
+static int virgl_video_create_encoder(struct virgl_video_codec *codec,
+                                      uint32_t rc_method)
+{
+    VAStatus va_stat;
+    VAConfigAttrib attr[2];
+    VAProfile profile = va_profile_from_pipe(codec->profile);
+    VAEntrypoint entrypoint = va_entrypoint_from_pipe(codec->entrypoint);
+    VAConfigID cfg;
+    VAContextID ctx;
+
+    if (codec->va_ctx && codec->rc_method == rc_method)
+        return 0;
+
+    if (codec->va_ctx) {
+        if (codec->va_coded_buf) {
+            vaDestroyBuffer(va_dpy, codec->va_coded_buf);
+            codec->va_coded_buf = 0;
+        }
+        vaDestroyContext(va_dpy, codec->va_ctx);
+        vaDestroyConfig(va_dpy, codec->va_cfg);
+        codec->va_ctx = 0;
+        codec->va_cfg = 0;
+    }
+
+    attr[0].type = VAConfigAttribRTFormat;
+    attr[0].value = codec->va_rt_format;
+    attr[1].type = VAConfigAttribRateControl;
+    attr[1].value = va_rc_from_pipe_rc(rc_method);
+
+    va_stat = vaCreateConfig(va_dpy, profile, entrypoint, attr, 2, &cfg);
+    if (VA_STATUS_SUCCESS != va_stat) {
+        /* A driver may refuse a mode it does not implement (QVBR is the common
+         * one).  Fall back to declaring no mode - the previous behaviour -
+         * rather than failing the whole encode. */
+        virgl_warn("create config with rate control 0x%x failed (0x%x), retrying without\n",
+                   attr[1].value, va_stat);
+        va_stat = vaCreateConfig(va_dpy, profile, entrypoint, &attr[0], 1, &cfg);
+        if (VA_STATUS_SUCCESS != va_stat) {
+            virgl_error("create config failed, err = 0x%x\n", va_stat);
+            return -1;
+        }
+        rc_method = PIPE_H2645_ENC_RATE_CONTROL_METHOD_DISABLE;
+    }
+    codec->va_cfg = cfg;
+
+    va_stat = vaCreateContext(va_dpy, cfg, codec->width, codec->height,
+                              VA_PROGRESSIVE, NULL, 0, &ctx);
+    if (VA_STATUS_SUCCESS != va_stat) {
+        virgl_error("create context failed, err = 0x%x\n", va_stat);
+        vaDestroyConfig(va_dpy, codec->va_cfg);
+        codec->va_cfg = 0;
+        return -1;
+    }
+    codec->va_ctx = ctx;
+    codec->rc_method = rc_method;
+
+    va_stat = vaCreateBuffer(va_dpy, codec->va_ctx, VAEncCodedBufferType,
+                             CODED_BUF_DEFAULT_SIZE(codec->width, codec->height),
+                             1, NULL, &codec->va_coded_buf);
+    if (VA_STATUS_SUCCESS != va_stat)
+        virgl_error("create coded buffer failed, err = 0x%x\n", va_stat);
+
+    return 0;
+}
