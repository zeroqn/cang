From: cang <cang@localhost>
Subject: [PATCH] va: h264: stop the RBSP readers at the end of the NAL

vaRenderPicture() can hang forever on a client-supplied packed header.

vl_rbsp_ue() (src/util/vl_rbsp.h) reads an exponential-Golomb code with

   while (!vl_vlc_get_uimsbf(&rbsp->nal, 1)) {
      ++bits;
      if (bits == 16)
         vl_rbsp_fillbits(rbsp);
   }

with no end-of-NAL check. Once the RBSP is exhausted, vl_rbsp_fillbits() cannot
add any more bits, so the "next bit" reads as zero for ever and `bits` grows
without bound - the loop never returns. In a release build this is a silent
hang (a debug build trips the assertion in vl_vlc_get_uimsbf instead). A client
that hands the encoder a packed header whose parse walks past the end of its NAL
therefore wedges the driver: measured in a VM, an H.264 High-profile
constant-QP encode hangs inside parseEncSpsParamsH264() for the client's
SPS/PPS buffer, with nothing ever submitted to the GPU.

The same shape appears three times in parseEncSliceParamsH264(), whose
`while (true)` ref-list and marking loops only exit when the bitstream supplies
a terminator (modification_of_pic_nums_idc == 3,
memory_management_control_operation == 0), and in the packed-header handler's
outer scan, whose loop condition uses vl_vlc_bits_left() - a value that
*underflows* to a huge unsigned once the reads run past the buffer end.

parseEncHrdParamsH264() is the other half of the problem: its

   for (i = 0; i <= hrd_params->cpb_cnt_minus1; ++i)

writes into 32-entry arrays (bit_rate_value_minus1[], cpb_size_value_minus1[],
cbr_flag[]) with an unbounded, client-controlled count. For a truncated or
corrupt stream that is both an out-of-bounds write and, when the garbage count
is large, an effectively infinite loop.

Fix all four: stop the RBSP readers when nothing is left, bound the loops by the
arrays they fill / by the end of the RBSP, and stop the packed-header scan when
its buffer is exhausted. Values produced by a well-formed stream are unchanged.

--- a/src/util/vl_rbsp.h
+++ b/src/util/vl_rbsp.h
@@ -153,6 +153,9 @@
    vl_rbsp_fillbits(rbsp);
    while (!vl_vlc_get_uimsbf(&rbsp->nal, 1)) {
       ++bits;
+      if (rbsp->nal.invalid_bits >= 32 &&
+          rbsp->nal.data >= rbsp->nal.end && rbsp->nal.bytes_left == 0)
+         return 0;
       if (bits == 16)
          vl_rbsp_fillbits(rbsp);
    }
--- a/src/gallium/frontends/va/picture_h264_enc.c
+++ b/src/gallium/frontends/va/picture_h264_enc.c
@@ -488,6 +488,9 @@
       slice->ref_pic_list_modification_flag_l0 = vl_rbsp_u(rbsp, 1);
       if (slice->ref_pic_list_modification_flag_l0) {
          while (true) {
+            if (rbsp->nal.invalid_bits >= 32 &&
+                rbsp->nal.data >= rbsp->nal.end && rbsp->nal.bytes_left == 0)
+               break;
             modification_of_pic_nums_idc = vl_rbsp_ue(rbsp);
             if (modification_of_pic_nums_idc == 3)
                break;
@@ -510,6 +513,9 @@
       slice->ref_pic_list_modification_flag_l1 = vl_rbsp_u(rbsp, 1);
       if (slice->ref_pic_list_modification_flag_l1) {
          while (true) {
+            if (rbsp->nal.invalid_bits >= 32 &&
+                rbsp->nal.data >= rbsp->nal.end && rbsp->nal.bytes_left == 0)
+               break;
             modification_of_pic_nums_idc = vl_rbsp_ue(rbsp);
             if (modification_of_pic_nums_idc == 3)
                break;
@@ -536,6 +542,9 @@
          slice->adaptive_ref_pic_marking_mode_flag = vl_rbsp_u(rbsp, 1);
          if (slice->adaptive_ref_pic_marking_mode_flag) {
             while (true) {
+               if (rbsp->nal.invalid_bits >= 32 &&
+                   rbsp->nal.data >= rbsp->nal.end && rbsp->nal.bytes_left == 0)
+                  break;
                memory_management_control_operation = vl_rbsp_ue(rbsp);
                if (memory_management_control_operation == 0)
                   break;
@@ -587,7 +596,7 @@
    hrd_params->cpb_cnt_minus1 = vl_rbsp_ue(rbsp);
    hrd_params->bit_rate_scale = vl_rbsp_u(rbsp, 4);
    hrd_params->cpb_size_scale = vl_rbsp_u(rbsp, 4);
-   for (i = 0; i <= hrd_params->cpb_cnt_minus1; ++i) {
+   for (i = 0; i <= hrd_params->cpb_cnt_minus1 && i < ARRAY_SIZE(hrd_params->bit_rate_value_minus1); ++i) {
       hrd_params->bit_rate_value_minus1[i] = vl_rbsp_ue(rbsp);
       hrd_params->cpb_size_value_minus1[i] = vl_rbsp_ue(rbsp);
       hrd_params->cbr_flag[i] = vl_rbsp_u(rbsp, 1);
@@ -809,6 +818,8 @@
    vl_vlc_init(&vlc, 1, (const void * const*)&data, &buf->size);
 
    while (vl_vlc_bits_left(&vlc) > 0) {
+      if (vlc.invalid_bits >= 32 && vlc.data >= vlc.end && vlc.bytes_left == 0)
+         break;
       /* search the first 64 bytes for a startcode */
       for (int i = 0; i < 64 && vl_vlc_bits_left(&vlc) >= 24; ++i) {
          if (vl_vlc_peekbits(&vlc, 24) == 0x000001)
